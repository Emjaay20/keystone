{
  "name": "keystone",
  "private": true,
  "version": "0.1.0",
  "description": "IAM and entitlements control plane for a multi-product security suite",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @keystone/api",
    "test:api": "npm run test -w @keystone/api",
    "test:domain": "npm run test -w @keystone/domain",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
